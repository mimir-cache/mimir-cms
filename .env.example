# PostgreSQL connection (Supabase in production, local docker-compose in development)
# Port 5433 — the mimir docker-compose maps Postgres to 5433 to avoid clashing with
# a native/local PostgreSQL install that may already own port 5432.
DATABASE_URL=postgresql://mimir:mimir@localhost:5433/mimir_cms

# Payload encryption secret — generate a long random string for real deployments
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Base URL of the MIMIR FastAPI middleware (used by dashboard integrations)
MIMIR_BACKEND_URL=http://localhost:8000

# Must match the backend's MIMIR_ADMIN_API_KEY — required for the "MIMIR Analytics" admin panel
MIMIR_ADMIN_API_KEY=YOUR_ADMIN_KEY_HERE
